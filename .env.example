# copiar a .env y completar

# --- LLM (obligatorio: una key, o Ollama local) ---
# Valores posibles de LLM_PROVIDER: openai, anthropic, gemini, ollama
# Si está vacío, se usa la primera key que encuentre en este orden: OpenAI,
# Anthropic, Gemini. Ollama NUNCA se elige solo: hay que poner LLM_PROVIDER=ollama.
LLM_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# modelos por defecto: gpt-4o-mini / claude-sonnet-4-6 / gemini-flash-latest
# OPENAI_MODEL=
# ANTHROPIC_MODEL=
# GEMINI_MODEL=

# Ollama (local, sin API key): para practicar sin gastar cuota. Requiere
# Ollama abierto y el modelo descargado (ollama pull llama3.2). Los modelos
# chicos eligen herramientas peor: la traza a entregar, mejor con un proveedor en la nube.
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
# 0 = el agente elige herramientas de forma consistente entre corridas
TEMPERATURE=0

# --- Agente ---
# Techo de pasos del grafo por pregunta (evita bucles infinitos y costos)
RECURSION_LIMIT=10
# Mensajes recientes que ve el LLM (el historial completo queda en SQLite)
MAX_MENSAJES_CONTEXTO=20

# --- Persistencia y trazas ---
CHECKPOINT_DB=checkpoints.sqlite
TRAZAS_DIR=trazas
